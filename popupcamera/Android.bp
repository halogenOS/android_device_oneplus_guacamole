android_app {
    name: "PopupCameraController",
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,

    static_libs: [
        "vendor.oplus.hardware.popupcamera-V1-java",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
